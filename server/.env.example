PORT=4000
DATABASE_URL="postgresql://employee_user:employee_password@localhost:5432/employee_portal?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret"
CLIENT_ORIGIN="*"

# SendGrid is only required for real @gmail.com signup verification and password reset OTPs.
# Get a free API key at sendgrid.com. SENDGRID_FROM must be an email you've verified
# as a Single Sender in the SendGrid dashboard (Settings > Sender Authentication).
SENDGRID_API_KEY=
SENDGRID_FROM=
OTP_EXPIRY_MINUTES=10

# Optional free local LLM for the Leave "AI Rephrase" button.
# Leave blank to use the built-in no-cost rephrasing fallback.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
