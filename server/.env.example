PORT=4000
DATABASE_URL="postgresql://employee_user:employee_password@localhost:5432/employee_portal?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret"
CLIENT_ORIGIN="*"

# Gmail SMTP is only required for real @gmail.com signup verification and password reset OTPs.
# Use a Gmail account you control as the sender and create a Google App Password for it.
GMAIL_USER=
GMAIL_APP_PASSWORD=
OTP_EXPIRY_MINUTES=10

# Optional free local LLM for the Leave "AI Rephrase" button.
# Leave blank to use the built-in no-cost rephrasing fallback.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
