PORT=4000
DATABASE_URL="postgresql://employee_user:employee_password@localhost:5432/employee_portal?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret"
CLIENT_ORIGIN="*"

# Resend is only required for real @gmail.com signup verification and password reset OTPs.
# Get a free API key at resend.com. RESEND_FROM is optional (defaults to the Resend sandbox sender).
RESEND_API_KEY=
RESEND_FROM=
OTP_EXPIRY_MINUTES=10

# Optional free local LLM for the Leave "AI Rephrase" button.
# Leave blank to use the built-in no-cost rephrasing fallback.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
