generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  HEAD_MANAGER
}

enum LeaveType {
  CASUAL
  SICK
  VACATION
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

enum CheckoutType {
  MANUAL
  AUTOMATIC
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A Team is owned by exactly one Manager/Head Manager (managerId), independent
// of Department. Teams are created atomically with their manager (see
// management.routes.js) so a team never exists without an owner, and are
// deleted when that person is demoted back to Employee.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  managerId String?  @unique
  manager   User?    @relation("TeamManagerOf", fields: [managerId], references: [id], onDelete: SetNull)
  users     User[]   @relation("TeamMembers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String   @id @default(cuid())
  employeeId         String   @unique
  name               String
  email              String   @unique
  emailVerified      Boolean  @default(false)
  passwordHash       String
  phone              String?
  profilePicture     String?
  role               Role     @default(EMPLOYEE)
  jobTitle           String?
  // Float (not Int): monthly accrual (see jobs/leaveAccrual.js) grants
  // fractional days (e.g. 1.67/month) instead of a flat yearly amount.
  availableLeaveDays Float    @default(20)
  // Set by the monthly accrual job so it only grants once per calendar
  // month even if the job runs more than once (e.g. server restart).
  lastAccrualAt      DateTime?
  isActive           Boolean  @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // The team this person belongs to. For a Manager/Head Manager this is
  // always the same team they lead (see managedTeam below); for an Employee
  // it is always derived from their supervisor's team, never set directly.
  teamId String?
  team   Team? @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)

  // The team this person owns as its Manager/Head Manager, if any. Created
  // atomically with the Manager/Head Manager account (or role promotion)
  // and deleted when they are demoted back to Employee.
  managedTeam Team? @relation("TeamManagerOf")

  supervisorId  String?
  supervisor    User?  @relation("SupervisorReports", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports User[] @relation("SupervisorReports")

  attendances    Attendance[]
  leaveRequests  LeaveRequest[] @relation("LeaveOwner")
  reviewedLeaves LeaveRequest[] @relation("LeaveReviewer")
  notifications Notification[]  @relation("NotificationRecipient")
  auditActions   AuditLog[]      @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supervisorId])
  @@index([departmentId])
  @@index([teamId])
  @@index([role])
  @@index([isActive])
}

model Attendance {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDate         DateTime @db.Date
  checkInTime      DateTime
  checkOutTime     DateTime?
  checkInLatitude  Float
  checkInLongitude Float
  checkOutLatitude Float?
  checkOutLongitude Float?
  // IANA timezone (e.g. "America/Los_Angeles") resolved from checkInLatitude/checkInLongitude.
  // Drives the 5pm local-time automatic checkout cutoff; independent of server/viewer timezone.
  checkInTimezone  String?
  checkoutType     CheckoutType?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, workDate])
  @@index([userId, workDate])
  @@index([checkOutTime])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)
  leaveType    LeaveType
  fromDate     DateTime     @db.Date
  toDate       DateTime     @db.Date
  reason       String
  days         Int
  status       LeaveStatus  @default(PENDING)
  reviewedById String?
  reviewedBy   User?        @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   @default("INFO")
  entityId    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, isRead, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model OtpCode {
  id        String     @id @default(cuid())
  email     String
  purpose   OtpPurpose
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}
